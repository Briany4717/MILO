# Este es un archivo de ejemplo.
# Copia este archivo a .env y reemplaza los valores con tu configuración.

# --- Configuración de Red ---
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765

# --- Configuración ESP32 (Módulo Sensorial) ---
# Habilitar funcionalidad ESP32 (true/false)
# Si está en true, el servidor esperará la conexión del ESP32
ESP32_ENABLED=false

# NOTA: El ESP32 se conecta AL SERVIDOR, no al revés
# El ESP32 debe conectarse a: ws://TU_SERVIDOR:8765
# Si tu servidor tiene un dominio: ws://miservidor.com:8765
# Asegúrate de que el ESP32 pueda alcanzar el servidor (mismo puerto que WEBSOCKET_PORT)

# --- Configuración de Modelos ---
# Modelos de Whisper: "tiny", "base", "small", "medium", "large"
WHISPER_MODEL_SIZE=base

# --- Configuración de LLM (Proveedor de IA) ---
# Proveedor de LLM: "ollama" (agente local) o "gemini" (agente remoto mediante API)
LLM_PROVIDER=ollama

# Configuración de Ollama (Agente Local)
# Requiere tener Ollama instalado y corriendo: https://ollama.com
OLLAMA_MODEL=llama3:8b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434/v1

# Configuración de Gemini (Agente Remoto)
# Obtén tu API key en: https://aistudio.google.com/app/apikey
# Modelos disponibles: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-1.5-flash

# --- Configuración de TTS (Text-to-Speech) ---
# Backend TTS: "xtts", "piper", or "vits"
#   - xtts: Coqui XTTS v2 (mejor calidad, requiere GPU, clonación o presets)
#   - piper: Rápido en CPU (buena calidad, sin GPU)
#   - vits: EXPERIMENTAL - Mejor expresión emocional, rápido (requiere GPU)
TTS_BACKEND=xtts

# Modo XTTS: "preset" (voces predefinidas - RÁPIDO) o "clone" (clonación de voz - más lento pero personalizado)
XTTS_MODE=preset

# Configuración XTTS v2 en modo CLONE (solo si XTTS_MODE=clone)
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
TTS_SPEAKER_WAV=samples/alejandro_sample_v2.wav

# Configuración XTTS v2 en modo PRESET (solo si XTTS_MODE=preset)
# Voces disponibles en español:
# 
# Español Latino (México/América Latina):
#   Masculinas: Abrahan Mack (RECOMENDADA), Dionisio Schuyler
#   Femeninas: Ana Florence, Alison Dietlinde
# 
# Español Peninsular (España):
#   Femeninas: Daisy Studious, Gracie Wise, Claribel Dervla
#   Masculinas: Andrew Chipper, Viktor Eka
XTTS_PRESET_VOICE=Abrahan Mack

# Control de emoción y velocidad
# Emotion: Neutral, Happy (feliz/entusiasta), Sad (triste), Angry (enojado), 
#          Dull (aburrido/monótono), Surprised (sorprendido)
# Temperature: 0.1-1.5 (0.7=neutral, 0.85=entusiasta, 1.0=muy expresivo)
# Speed: 0.5-2.0 (1.0=normal, 1.2=más rápido, 0.8=más lento)
XTTS_EMOTION=Happy
XTTS_TEMPERATURE=0.85
XTTS_SPEED=1.0

# Configuración Piper TTS (solo si TTS_BACKEND=piper)
# Descargar modelos desde: https://github.com/rhasspy/piper/releases
PIPER_MODEL_PATH=models/piper/es_ES-sharvard-medium.onnx
PIPER_CONFIG_PATH=models/piper/es_ES-sharvard-medium.onnx.json
PIPER_SPEAKER_ID=0

# --- Configuración VITS TTS (solo si TTS_BACKEND=vits) ---
# VITS ofrece mejor expresión emocional que XTTS y es más rápido
# Modelos disponibles (español):
#   - tts_models/es/css10/vits (español neutro - RECOMENDADO)
#   - tts_models/es/mai/tacotron2-DDC (español de España)
# Lista completa: https://github.com/coqui-ai/TTS
VITS_MODEL=tts_models/es/css10/vits

# Control emocional VITS (⚠️  MUY LIMITADO - mayoría de modelos no lo soportan)
# El modelo css10 NO tiene soporte real de emociones
# Para emociones, usa XTTS preset mode con XTTS_EMOTION
VITS_EMOTION=neutral

# Velocidad VITS: 0.5-2.0 (1.0=normal, 1.2=más rápido, 0.8=más lento)
VITS_SPEED=1.0

# ⚠️  RECOMENDACIÓN: Para español mexicano/latino con emociones, usa:
#     TTS_BACKEND=xtts
#     XTTS_MODE=preset
#     XTTS_PRESET_VOICE=Abrahan Mack
#     XTTS_EMOTION=Happy

